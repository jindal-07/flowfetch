# =============================================================================
# Media Downloader - environment configuration
# =============================================================================
# Copy this file to `.env` and fill in your values for local development.
# On Hugging Face Spaces, set these in Settings -> Variables and secrets instead.

# --- Microsoft Graph OAuth (for SharePoint) ----------------------------------
# Create an Azure AD app registration with:
#   Delegated permissions: Files.Read.All, User.Read, offline_access
#   Web redirect URI: http://127.0.0.1:8000/auth/callback
#                    (and your HF Space URL: https://<user>-<space>.hf.space/auth/callback)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Auth mode: "delegated" (default, each user signs in) or "app"
# (Application permission Files.Read.All + admin consent, no sign-in;
# needs a real AZURE_TENANT_ID, AZURE_REDIRECT_URI is unused).
AZURE_AUTH_MODE=delegated

# --- Access gate --------------------------------------------------------------
# Password-protects the whole site with a browser login prompt.
# Strongly recommended when AZURE_AUTH_MODE=app.
FLOWFETCH_USERNAME=flowfetch
FLOWFETCH_PASSWORD=

# --- Session signing ---------------------------------------------------------
# Used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random one is generated at startup (sessions die on restart).
SESSION_SECRET=

# --- Server bind (usually fine as defaults) ----------------------------------
HOST=127.0.0.1
PORT=8000
