# =============================================================================
# Media Downloader - environment configuration
# =============================================================================
# Copy this file to `.env` and fill in your values for local development.
# On Hugging Face Spaces, set these in Settings -> Variables and secrets instead.

# --- Microsoft Graph app-only access (for SharePoint) ------------------------
# Azure app registration with the Application permission Files.Read.All
# (admin consent granted). No sign-in or redirect URI is involved.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Access gate --------------------------------------------------------------
# Password for the login screen. Strongly recommended: the server can read
# every file the app can access. Changing it logs every device out.
FLOWFETCH_PASSWORD=
# How long "Remember me" keeps a device logged in.
FLOWFETCH_REMEMBER_DAYS=30

# --- Server bind (usually fine as defaults) ----------------------------------
HOST=127.0.0.1
PORT=8000
